# Copy this file to .env.local and fill in values from
# Supabase dashboard -> Project Settings -> API.
# In Vercel, add the same two variables under Project -> Settings -> Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (or the legacy "anon" key). Safe to expose in the browser;
# row-level security in supabase/migrations keeps each user's data private.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
